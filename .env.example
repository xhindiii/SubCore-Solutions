# SubCore Solutions — configuration reference (placeholders only, no real values).
#
# This website is static (GitHub Pages) and has no server-side environment variables.
# The only configuration is the two PUBLIC values at the top of supabase-client.js:
#
#   SUPABASE_URL = https://<your-project-ref>.supabase.co
#   SUPABASE_KEY = <anon / publishable key>      # public by design; protected by Row Level Security
#
# NEVER add any of these to the repository or to a browser file:
#   SUPABASE_SERVICE_ROLE_KEY   (bypasses all security rules)
#   DATABASE_URL / database password
#   SMTP or payment-provider secrets
#
# If you later add a server-side function (e-mail notifications, payments), keep its secrets in
# that platform's secret store, not in this repo, and use this file only as a list of names:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-side only, never in the browser

# Order e-mail notifications (Supabase Edge Function secrets — see NOTIFICATIONS.md). Names only:
RESEND_API_KEY=              # e-mail service key, secret store only
NOTIFY_WEBHOOK_SECRET=       # random 24+ chars; same value goes in the schedule's vault secret
NOTIFY_TO=                   # the approved company Gmail address
NOTIFY_FROM=                 # sender on a VERIFIED domain you own (not Gmail)
NOTIFY_DRY_RUN=true          # keep true until staging tests pass
ADMIN_BASE_URL=              # optional, default https://subcoresolutions.online/admin.html
